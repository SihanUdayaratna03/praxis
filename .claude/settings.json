{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "includeCoAuthoredBy": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_no_secrets.py\"",
            "timeout": 60,
            "statusMessage": "scanning for credential material"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_git_workflow.py\"",
            "timeout": 60,
            "statusMessage": "checking branch and merge rules"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/post_edit_verify.py\"",
            "timeout": 180,
            "statusMessage": "ruff + mypy on the edited file"
          }
        ]
      }
    ]
  }
}
