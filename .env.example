# Copy to .env and edit. Every value below is optional: with no .env at all,
# Praxis runs the full pipeline, test suite, eval harness and dashboard
# offline, with no credentials. That is the default, not a fallback.
#
#   cp .env.example .env
#
# .env is gitignored and a pre-commit hook refuses to let it be committed.

# ---------------------------------------------------------------------------
# Model access
# ---------------------------------------------------------------------------

# mock     deterministic, offline, zero credentials. The default.
# anthropic  live models. Requires PRAXIS_ANTHROPIC_API_KEY below.
# replay   replays recorded responses from PRAXIS_REPLAY_DIR.
PRAXIS_LLM_PROVIDER=mock

# Only read when PRAXIS_LLM_PROVIDER=anthropic. Leave empty otherwise.
# Switching to live models is this line plus the one above, and nothing else.
PRAXIS_ANTHROPIC_API_KEY=

# Recorded provider responses, used by the replay provider.
PRAXIS_REPLAY_DIR=tests/fixtures/replay

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------

# Root for the SQLite store and the LLM trace log. Gitignored.
PRAXIS_DATA_DIR=.praxis

# Seeds every source of randomness. Two eval runs over the same corpus with
# the same seed must produce identical numbers.
PRAXIS_SEED=20260809

# A run aborts rather than exceed this, in USD. Guards against a runaway
# agent loop turning into a bill.
PRAXIS_COST_CEILING_USD=5.0

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

PRAXIS_LOG_LEVEL=INFO

# json     structured, queryable. The default and what CI uses.
# console  human-readable, for watching a local run.
PRAXIS_LOG_FORMAT=json
